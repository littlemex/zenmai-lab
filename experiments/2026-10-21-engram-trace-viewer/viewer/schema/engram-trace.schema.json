{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engram-trace.schema.json",
  "title": "engram-trace v1",
  "description": "The Engram n-gram lookups of one token sequence. hash_rows is required; gates, generation and lens are optional, and a viewer shows them only when present.",
  "type": "object",
  "required": [
    "format",
    "version",
    "layers",
    "tokens",
    "hash_rows",
    "model"
  ],
  "properties": {
    "format": {
      "const": "engram-trace"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      }
    },
    "source": {
      "description": "Where the hashing came from, pinned so the trace can be reproduced.",
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "provenance": {
      "description": "One sentence per field saying how it was obtained, or null when the field is absent.",
      "type": "object",
      "properties": {
        "hash_rows": {
          "type": [
            "string",
            "null"
          ]
        },
        "gates": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "max_ngram_size",
        "n_heads"
      ],
      "properties": {
        "max_ngram_size": {
          "type": "integer",
          "minimum": 2
        },
        "n_heads": {
          "type": "integer",
          "minimum": 1
        },
        "head_dim": {
          "type": "integer"
        },
        "hc_mult": {
          "type": "integer"
        },
        "pad_compressed_id": {
          "type": "integer"
        }
      }
    },
    "layers": {
      "description": "One entry per Engram layer, in the order of the second axis of hash_rows.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layer_id",
          "num_rows",
          "columns"
        ],
        "properties": {
          "layer_id": {
            "type": "integer"
          },
          "num_rows": {
            "type": "integer",
            "minimum": 1
          },
          "columns": {
            "description": "The table's row ranges, one per (n-gram size, head), in the order of the third axis of hash_rows. Ranges are contiguous and cover num_rows.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "n",
                "head",
                "offset",
                "size"
              ],
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 2
                },
                "head": {
                  "type": "integer",
                  "minimum": 0
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "size": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "compressed_id": {
            "type": "integer",
            "description": "The id after the model's tokenizer compression; tokens that normalize alike share it."
          },
          "display": {
            "type": "string",
            "description": "Optional label for a token whose text alone is not readable, such as one byte of a multi-byte character."
          }
        }
      }
    },
    "hash_rows": {
      "description": "[position][layer][column]: the table row each lookup reads, counted from the start of the layer's table.",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "gates": {
      "description": "Optional. [position][layer][hc copy]: the gate value in (0, 1) the model applied.",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "generation": {
      "description": "Optional. How the tokens were produced: the first prompt_tokens were given, the rest generated.",
      "type": "object",
      "required": [
        "prompt_tokens"
      ],
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "new_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "by": {
          "type": "string",
          "description": "The lens variant that generated the tokens."
        },
        "method": {
          "type": "string"
        }
      }
    },
    "lens": {
      "description": "Optional. LogitLens of one or more model variants over the same tokens: what each block's residual stream predicts as the next token. The ladder view needs it.",
      "type": "object",
      "required": [
        "n_layer",
        "variants",
        "vocab",
        "values"
      ],
      "properties": {
        "n_layer": {
          "type": "integer",
          "minimum": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "engram_before_block": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Blocks the Engram output is added in front of."
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "label"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "checkpoint_step": {
                "type": "integer"
              },
              "engram": {
                "enum": [
                  "added",
                  "skipped",
                  "absent"
                ],
                "description": "What the variant does at engram_before_block: adds the Engram output (gates belong to this variant), skips it, or has no Engram layer."
              }
            }
          }
        },
        "vocab": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Text of every token id that appears in a top list, keyed by the id as a string."
        },
        "values": {
          "type": "object",
          "description": "Variant name -> [position][block].",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "top",
                  "p_final",
                  "kl"
                ],
                "properties": {
                  "top": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      ],
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "description": "The top-k [token id, probability], most probable first."
                  },
                  "p_final": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The probability this block gives to the variant's own final top-1 token."
                  },
                  "p_next": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The probability of the actual next token; null at the last position."
                  },
                  "kl": {
                    "type": "number",
                    "minimum": -0.001,
                    "description": "KL(final || this block), in nats."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
